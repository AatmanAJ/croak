# Copy this file to .env and fill in the values. .env is never committed.
OPENAI_API_KEY=
DISCORD_TOKEN=
# Optional: your test server ID, so /croak appears there instantly
DEV_GUILD_ID=
# Optional: AI calls allowed per day (all servers / per server)
AI_DAILY_LIMIT=20000
AI_DAILY_LIMIT_PER_SERVER=3000
# Optional: a URL pinged every minute, for an uptime monitor
HEARTBEAT_URL=
